{
  "name": "ngekosaja-database-foundation",
  "version": "3.0.0-phase.2",
  "private": true,
  "description": "NgekosAja.com - property marketplace, rental payments and property management; optional development tooling.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/serve-auth.mjs",
    "auth:configure": "node scripts/configure-auth.mjs",
    "auth:provision-development": "node scripts/provision-development-accounts.mjs",
    "test:auth-provision": "node --test tests/development-provision.test.mjs tests/development-verification.test.mjs",
    "auth:repair-test-account": "node scripts/repair-test-account.mjs",
    "test:auth-repair": "node --test tests/auth-repair.test.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset:local": "supabase db reset",
    "db:test": "node scripts/database-test.mjs --extended",
    "db:fixtures": "node scripts/provision-fixtures.mjs",
    "db:docs": "node scripts/database-docs.mjs",
    "test:content": "node scripts/content-audit.mjs",
    "test:frontend": "node tests/domain.cjs",
    "test:database-tooling": "node --test tests/database-tooling.test.mjs",
    "test:backend": "node --test tests/backend-core.test.mjs",
    "backend:review": "node scripts/backend-remote-review.mjs",
    "phase4:review": "node scripts/phase4-review.mjs",
    "phase4:verify-remote": "node scripts/verify-phase4-remote.mjs",
    "phase4:plan": "node scripts/phase4-dry-run.mjs",
    "test:phase4": "node --test tests/live-core.test.mjs",
    "test:phase4-sql": "node scripts/database-test.mjs --native --extended --development-accounts --backend --phase4 --output=tests/phase4-upgrade-results.json",
    "payment:review": "node scripts/payment-review.mjs",
    "test:payment": "node --test tests/payment-edge.test.mjs",
    "test:payment-sql": "node scripts/database-test.mjs --native --extended --development-accounts --backend --phase4 --phase5 --output=tests/phase5-simulator-upgrade-results.json",
    "test:payment-runtime": "node scripts/payment-runtime-check.mjs",
    "test:payment-audit": "node scripts/payment-local-check.mjs"
  },
  "devDependencies": {
    "pg": "8.23.1",
    "supabase": "3.2.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.99.3"
  }
}
