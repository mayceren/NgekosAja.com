{
  "name": "ngekosaja-database-foundation",
  "version": "3.0.0-phase.1",
  "private": true,
  "description": "Optional database development tools; the frontend still runs without npm.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset:local": "supabase db reset",
    "db:test": "node scripts/database-test.mjs --extended",
    "db:fixtures": "node scripts/provision-fixtures.mjs",
    "db:docs": "node scripts/database-docs.mjs",
    "test:frontend": "node tests/domain.cjs",
    "test:database-tooling": "node --test tests/database-tooling.test.mjs"
  },
  "devDependencies": {
    "pg": "8.23.1",
    "supabase": "3.2.0"
  }
}
