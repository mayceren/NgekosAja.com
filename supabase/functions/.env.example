# Copy to .env.local (ignored). Enter real Sandbox keys only in a PRIVATE terminal/editor.
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
PAYMENT_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# Local Supabase CLI injects SUPABASE_URL/ANON_KEY/SERVICE_ROLE_KEY.
# Never place privileged keys in config/runtime.js or frontend storage.
